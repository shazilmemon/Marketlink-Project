{
  "name": "marketlink",
  "version": "1.0.0",
  "private": true,
  "description": "MarketLink - eGreen Basket End-to-End Agricultural Marketplace Foundation",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend run test",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": [
    "agricultural-marketplace",
    "farmers-market",
    "traceability",
    "ai-demand-forecasting",
    "egreen-basket"
  ],
  "author": "MarketLink Architecture Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

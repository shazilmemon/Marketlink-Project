# ==========================================
# MARKETLINK ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# SERVER CONFIGURATION
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# DATABASE
# Local MongoDB or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/marketlink

# AUTHENTICATION & SECURITY
# Generate a strong 64+ char random string for production
JWT_SECRET=super_secret_jwt_key_change_in_production_min_64_chars_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_key_marketlink

# OAUTH PROVIDERS (Server-side ONLY - Never expose in frontend!)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# AI SERVICE ABSTRACTION PROVIDERS
# Provider options: mock | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# MAP SERVICE ABSTRACTION PROVIDERS
# Provider options: openstreetmap | googlemaps
MAP_PROVIDER=openstreetmap
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# STORAGE SERVICE ABSTRACTION PROVIDERS
# Provider options: local | s3 | cloudinary
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# FRONTEND PUBLIC CONFIGURATION (Safe for browser bundle)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME=MarketLink
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
